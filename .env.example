# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_BASE_URL=https://api.yourdomain.com

# ─────────────────────────────────────────────
# CORS
# Comma-separated list of allowed frontend origins.
# Development default (http://localhost:5173) is used when this is unset.
# Production example: https://app.yourdomain.com
# ─────────────────────────────────────────────
CORS_ORIGINS=https://app.yourdomain.com

# ─────────────────────────────────────────────
# Database
#
# Option A — Supabase (recommended for production)
#   Go to: Supabase Dashboard → Project Settings → Database → Connection string
#   Select "Transaction" mode (port 6543) for a pooled connection.
#   Set DATABASE_URL and leave the DB_* vars below empty.
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Option B — Local PostgreSQL (for development without Supabase)
#   Leave DATABASE_URL unset and fill in the individual vars below.
#   Run: docker-compose up -d  to start a local Postgres container.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=proxena
# DB_USER=postgres
# DB_PASSWORD=yourpassword

# ─────────────────────────────────────────────
# Firebase Admin SDK
# ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────
# Azure Cognitive Services Speech
# ─────────────────────────────────────────────
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# ─────────────────────────────────────────────
# Usage limits (per day)
# ─────────────────────────────────────────────
FREE_PLAN_DAILY_MINUTES=5
FREE_PLAN_DAILY_SESSIONS=3
PRO_PLAN_DAILY_MINUTES=999
PRO_PLAN_DAILY_SESSIONS=999

# ─────────────────────────────────────────────
# Session
# ─────────────────────────────────────────────
MAX_SESSION_DURATION_SECONDS=120
